# Copy to .env or set these variables in your shell. The values below are the defaults.
# Node does not read this file automatically.

# HTTP port the server listens on.
PORT=3000

# SQLite database file. Relative paths are resolved from the directory the server
# runs in; "npm start" and the server npm scripts run from server/, so the default
# file is server/data/hr-onboarding.db.
DATABASE_FILE=./data/hr-onboarding.db

# Vite dev server only: where /api requests are proxied.
# Defaults to http://localhost:$PORT when not set.
API_PROXY_TARGET=http://localhost:3000
