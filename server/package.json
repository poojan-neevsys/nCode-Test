{
  "name": "@neevsys/hr-onboarding-server",
  "version": "0.1.0",
  "private": true,
  "description": "HR Onboarding Portal API server (Express, TypeScript, SQLite via node:sqlite)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
