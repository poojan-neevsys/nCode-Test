# Copy this file to .env for local use and export the values into your shell
# (the server reads them from process.env). Values here are defaults, not secrets.

# TCP port the server listens on (serves the API and the built client).
PORT=3000

# Path to the SQLite database file. Relative paths are resolved from the
# directory the server is started in (server/ when using npm run dev -w server).
DATABASE_PATH=./data/hr-onboarding.db
